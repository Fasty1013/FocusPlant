{
  "manifest_version": 3,
  "name": "Focus Plant Pro",
  "version": "3.1",
  "description": "Анти-прокрастинатор с геймификацией, задачами, квестами и статистикой",
  "browser_specific_settings": {
    "gecko": {
      "id": "focusplantpro@extension.local"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}